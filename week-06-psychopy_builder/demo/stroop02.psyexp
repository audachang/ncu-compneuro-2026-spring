        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="歡迎參加Stroop效應實驗&amp;#10;&amp;#10;感謝您的參與。&amp;#10;&amp;#10;在本實驗中，螢幕中央會依序出現不同的中文字（例如：「紅」、「綠」、「藍」、「黃」）。&amp;#10;&amp;#10;這些中文字會以不同的物理顏色（墨水顏色）顯示。&amp;#10;您的任務：&amp;#10;&amp;#10;請忽略文字本身的意義，僅針對文字的**「物理顏色」**做出反應。&amp;#10;反應方式：&amp;#10;&amp;#10;請使用鍵盤上的按鍵來代表您看到的顏色：&amp;#10;&amp;#10;    如果您看到的文字顏色是紅色 → 請按 【R】 鍵&amp;#10;&amp;#10;    如果您看到的文字顏色是綠色 → 請按 【G】 鍵&amp;#10;&amp;#10;    如果您看到的文字顏色是藍色 → 請按 【B】 鍵&amp;#10;&amp;#10;    如果您看到的文字顏色是黃色 → 請按 【Y】 鍵&amp;#10;&amp;#10;範例：&amp;#10;&amp;#10;螢幕上出現：紅 (藍色的「紅」字)&amp;#10;→ 您應該按 【B】 鍵 (代表藍色)。&amp;#10;&amp;#10;請在保證正確性的前提下，盡可能快速地做出反應。&amp;#10;&amp;#10;如果您準備好了，請按【空白鍵 (Spacebar)】開始實驗。" valType="str" updates="constant" name="text"/>
        <Param val="norm" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1.8" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <KeyboardComponent name="key_instruct" plugin="None">
        <Param val="'space'" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="" valType="str" updates="constant" name="correctAns"/>
