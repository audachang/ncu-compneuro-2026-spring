# Course source folders that are kept out of this repository.
/textbook/
/materials/
/sections/
/term_project/

# Draft or superseded course folders.
/week-xx*/
/week-*_v1/

# Course planning scratch files.
weekly_contents.md
*lecture_plan*.md
*slide-outline.md
*speaker-notes.*

# Generated documents and LaTeX build artifacts.
*.pdf
!syllabus_*.pdf
*.aux
*.log
*.out
*.tmp
general/*.html
general/*_files/

# Python and notebook runtime artifacts.
__pycache__/
.ipynb_checkpoints/
.venv/

# Local agent/tooling state.
/.claude/worktrees/
/Context/
/Instructions/
.qa*

# PsychoPy demo output.
/week-06-numpy_and_data_manipulation/demo/

# Archive folders at any level.
archive/

# Homeworks: ignore student submissions and grading output; keep assignment specs.
/homeworks/*/submissions/
/homeworks/*/*.xlsx
/homeworks/*/*.zip
/homeworks/*/*.jzip
/homeworks/*/feedback*.md
/homeworks/*/feedback*.html
/homeworks/*/feedback_files/
/homeworks/*/index.html
/homeworks/hw_*.zip
/homeworks/hw_list.html

# Ignore student folders by numeric ID pattern.
/homeworks/*/1[0-9][0-9]*/

# Local Claude docs and solution materials may contain credentials, PII, or answers.
# AGENTS.md is the public course-agent guide.
CLAUDE.md
/homeworks/solutions/
/homeworks/*/solution/

# Student feedback HTML/CSS generated during grading.
/homeworks/*/*.html
/homeworks/*/_feedback.css

# Debug / dry-run screenshots in repo root.
debug_*.png
dry_run_*.png

# Office / LibreOffice lock files.
~$*
.~lock.*

# Local credentials.
.eeclass_passwd
